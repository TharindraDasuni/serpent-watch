# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Telegram: create a bot with @BotFather, then find your chat id (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: camera credentials referenced from config.yaml as ${CCTV_USER} etc.
# If a password contains special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
CCTV_USER=
CCTV_PASSWORD=
